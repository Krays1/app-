<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/button_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Trophy Icon -->
    <ImageView
        android:id="@+id/trophyIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_trophy"
        android:layout_marginEnd="12dp"
        android:contentDescription="Trophy" />

    <!-- Player Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/usernameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Player Name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/totalScoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Score: 0"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/gamesPlayedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Games: 0"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/highestScoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Best: 0"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/rankText"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/rank_badge_background"
        android:layout_marginStart="8dp" />

</LinearLayout> 