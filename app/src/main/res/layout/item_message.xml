<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Sent Message -->
    <LinearLayout
        android:id="@+id/sentMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="280dp">

            <TextView
                android:id="@+id/sentMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/message_sent_background"
                android:padding="12dp"
                android:textColor="#ffffff"
                android:textSize="16sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/sentProfilePic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_background_small"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"
            android:layout_gravity="bottom" />

    </LinearLayout>

    <!-- Received Message -->
    <LinearLayout
        android:id="@+id/receivedMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <ImageView
            android:id="@+id/receivedProfilePic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_background_small"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"
            android:layout_gravity="bottom" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="280dp">

            <TextView
                android:id="@+id/receivedSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender Name"
                android:textColor="@color/accent_color"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/receivedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/message_received_background"
                android:padding="12dp"
                android:textColor="#ffffff"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Audio Message -->
    <LinearLayout
        android:id="@+id/audioMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="12dp"
        android:layout_marginVertical="4dp">

        <ImageView
            android:id="@+id/audioProfilePic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_background_small"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"
            android:layout_gravity="center_vertical" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/circle_button_red"
            android:contentDescription="Play audio"
            android:layout_gravity="center_vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/audioSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender"
                android:textColor="#FFFF0000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/audioDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:05"
                android:textColor="#FF6666"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/messageTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout> 